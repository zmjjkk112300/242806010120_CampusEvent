@startuml CampusEventClassDiagram
skinparam dpi 150
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #0F6B5C
  ArrowColor #4B5563
  HeaderBackgroundColor #EAF4F1
}
hide empty members

package "表现层 (Flask Blueprints)" {
  class StudentRoutes <<Blueprint>> {
    +login()
    +activities()
    +activity_detail()
    +register()
    +cancel()
    +my_registrations()
    +messages()
  }
  class AdminRoutes <<Blueprint>> {
    +activities()
    +activity_new()
    +activity_edit()
    +activity_delete()
    +reviews()
    +approve()
    +reject()
  }
}

package "应用服务层" {
  class RegistrationService {
    -bus: DomainEventBus
    -registry: PolicyRegistry
    -activities: ActivityRepository
    -registrations: RegistrationRepository
    +register(activity_id, student_id)
    +cancel(registration_id, student_id)
    +approve(registration_id)
    +reject(registration_id)
    +stats(activity_id): dict
  }
}

package "策略 (Strategy)" {
  interface RegistrationPolicy {
    +policy_type: PolicyType
    +occupies_capacity_on_submit: bool
    +decide(context): RegistrationDecision
  }
  class DirectRegistrationPolicy {
    policy_type = direct
    occupies_capacity_on_submit = true
    +decide(context): RegistrationDecision
  }
  class ApprovalRegistrationPolicy {
    policy_type = approval
    occupies_capacity_on_submit = false
    +decide(context): RegistrationDecision
  }
  class PolicyRegistry {
    -policies: dict
    +register(policy)
    +get(policy_type): RegistrationPolicy
  }
  class RegistrationContext <<value object>> {
    +activity: Activity
    +student: Student
    +approved_count: int
    +now: datetime
  }
  class RegistrationDecision <<value object>> {
    +status: RegistrationStatus
    +event_type: str
  }
}

package "事件通知 (Observer)" {
  class DomainEventBus {
    -handlers: dict
    -failures: list
    +subscribe_all(handler, names)
    +publish(event): list
  }
  class RegistrationEvent <<event>> {
    +name: str
    +registration_id: int
    +activity_id: int
    +student_id: str
    +status: RegistrationStatus
    +event_key(): str
  }
  class InAppNotificationObserver <<observer>> {
    -session_factory
    +handle(event)
    +build_content(event): str
  }
}

package "仓储层" {
  class ActivityRepository {
    +get(id)
    +list(keyword)
    +create(**fields)
    +update(id, **fields)
    +delete(id)
  }
  class RegistrationRepository {
    +count_by_status(activity_id, status)
    +active_of(activity_id, student_id)
    +list_by_status(status)
  }
  class StudentRepository
  class MessageRepository
}

package "领域模型 (SQLite / SQLAlchemy)" {
  class Activity {
    activity_id: int
    title: str
    category: str
    start_at: datetime
    location: str
    capacity: int
    policy_type: PolicyType
  }
  class Student {
    student_id: str
    name: str
  }
  class Registration {
    registration_id: int
    activity_id: int
    student_id: str
    status: RegistrationStatus
    created_at: datetime
    updated_at: datetime
  }
  class Message {
    message_id: int
    student_id: str
    activity_id: int
    content: str
    event_key: str
    is_read: int
  }
}

StudentRoutes --> RegistrationService : 调用
AdminRoutes --> RegistrationService : 调用
AdminRoutes --> ActivityRepository : 增删改活动
StudentRoutes --> MessageRepository : 读取消息

RegistrationService --> PolicyRegistry : 选择策略
RegistrationService --> DomainEventBus : 发布事件
RegistrationService --> RegistrationRepository
RegistrationService --> ActivityRepository
PolicyRegistry o--> RegistrationPolicy : 持有
RegistrationPolicy <|-- DirectRegistrationPolicy
RegistrationPolicy <|-- ApprovalRegistrationPolicy
RegistrationPolicy ..> RegistrationDecision : 产生
RegistrationPolicy ..> RegistrationContext : 读取

DomainEventBus --> InAppNotificationObserver : 通知
DomainEventBus ..> RegistrationEvent : 分发
InAppNotificationObserver ..> Message : 写入
InAppNotificationObserver ..> RegistrationEvent : 消费

Registration "0..*" --> "1" Activity : 报名于
Registration "0..*" --> "1" Student : 属于
Message "0..*" --> "1" Student : 送达

note right of RegistrationService
  公共不变量在此校验：
  活动未开始、无重复有效报名、
  名额不超限（批准时复查）
end note

@enduml
